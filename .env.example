# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==================== PAYNOW PAYMENT GATEWAY ====================
# Paynow (https://www.paynow.co.zw) supports EcoCash, OneMoney and
# Visa/Mastercard from a single integration.
#
# Live mode: set PAYNOW_INTEGRATION_ID and PAYNOW_INTEGRATION_KEY with the
# values from your Paynow merchant account, and PAYMENT_MODE=live.
# Checkout redirects to Paynow, and the webhook at
# POST /api/billing/webhook verifies the transaction against Paynow before
# activating the subscription.
#
# Sandbox mode: leave the credentials empty (or PAYMENT_MODE=sandbox).
# The app simulates the gateway and fires the same webhook so the whole
# checkout -> webhook -> activation flow can be tested without real money.
PAYMENT_MODE=sandbox
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""

# Optional overrides
# PAYNOW_BASE_URL="https://www.paynow.co.zw/interface/remotetransaction"
# PAYMENT_CALLBACK_URL="http://localhost:3000/api/billing"

# ==================== SERVER / DEPLOYMENT ====================
# Most hosts (Render, Railway, Fly) set PORT automatically.
# PORT=3000

# Where runtime data is stored (users, sessions, workspaces, payments).
# In production, point this at a mounted persistent disk, e.g.:
# DATA_DIR=/opt/render/project/src/data
# DATA_DIR=/app/data

# ==================== SEARCH VISIBILITY (optional) ====================
# Enables "who is showing up above you" results in the Competitors tab.
# Create a Google Programmable Search Engine (https://programmablesearchengine.google.com)
# and a Custom Search JSON API key (https://developers.google.com/custom-search/v1/overview).
# Without these, competitor score comparison still works; rankings are simply
# reported as "not connected".
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""

# Optional: override the Custom Search endpoint (proxy/gateway, or a local stub
# while testing). Defaults to https://www.googleapis.com/customsearch/v1
GOOGLE_SEARCH_BASE_URL="https://www.googleapis.com/customsearch/v1"

# How long a login stays valid, in days. Defaults to 30.
# SESSION_TTL_DAYS=30

# Auth endpoints are rate limited per IP (30 requests / 15 minutes) in-process.
# If you run more than one instance, move that to your host's edge limiter.


# ─────────────────────────────────────────────────────────────────────────────
# Email (account confirmation + password reset + monitoring alerts)
# ─────────────────────────────────────────────────────────────────────────────
# Uses the Resend HTTP API, so there is no SMTP setup and no extra dependency.
#   RESEND_API_KEY   from https://resend.com/api-keys
#   EMAIL_FROM       must be a domain you have verified with Resend
#
# Without a key the server does NOT pretend to send: it logs the message, and
# outside production it returns the link in the API response so you can still
# test the whole flow locally.
RESEND_API_KEY=""
EMAIL_FROM="Search Vailable <onboarding@resend.dev>"


# ─────────────────────────────────────────────────────────────────────────────
# Automated monitoring
# ─────────────────────────────────────────────────────────────────────────────
# Paid plans get scheduled re-checks: Growth every 7 days, Agency every day.
# Free plans are never checked automatically.
#
# MONITORING_ENABLED=false turns the scheduler off entirely.
# MONITOR_INTERVAL_MINUTES is how often the scheduler wakes up to look for
#   businesses that are due (default 15).
#
# NOTE: this is an in-process timer, so it only runs while the server is awake.
# On hosts that sleep idle instances, also add an external cron (Render Cron
# Job, GitHub Action, cron-job.org) that calls POST /api/monitor/run.
MONITORING_ENABLED="true"
MONITOR_INTERVAL_MINUTES="15"


# ─────────────────────────────────────────────────────────────────────────────
# Google Analytics 4 (measured visitor behaviour)
# ─────────────────────────────────────────────────────────────────────────────
# One credential for the whole server — users only ever type a numeric property
# ID, never a secret. The app then shows the service-account address and asks
# the client to add it as a VIEWER on their GA4 property.
#
# Easiest form (paste the whole downloaded JSON key on one line):
#   GA4_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":...,"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
#
# Or set the two fields separately (the \n escapes in the key are handled):
#   GA4_CLIENT_EMAIL="ga4-reader@your-project.iam.gserviceaccount.com"
#   GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# Without these, the analytics panel simply does not appear: the drop-off
# section stays in its honest "inferred" mode.
GA4_SERVICE_ACCOUNT_JSON=""
# GA4_CLIENT_EMAIL=""
# GA4_PRIVATE_KEY=""

# Optional: override the Google endpoints (proxy/gateway, or a local stub
# while testing). Defaults are the real Google URLs.
# GA4_OAUTH_URL="https://oauth2.googleapis.com/token"
# GA4_API_BASE_URL="https://analyticsdata.googleapis.com/v1beta"





