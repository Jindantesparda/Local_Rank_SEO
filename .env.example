# GEMINI_API_KEY: Optional. Enables AI-written wording for the action plan and
# the copilot. Without it the app uses deterministic wording instead — nothing
# breaks, the text is just templated rather than bespoke.
#
# Keys from Google AI Studio may start with "AQ." (newer) or "AIza" (older).
# Both work; the app treats them as opaque secrets.
GEMINI_API_KEY=""

# GEMINI_MODEL: Which model the key can actually call. This matters more than it
# looks — Google restricts older models to existing users, so a brand-new key
# gets a 404 for gemini-2.5-flash and falls back to template wording silently.
# Verified working on a freshly created key (Sep 2026): gemini-3.6-flash.
# If you switch models, check the server log for "Gemini API call encountered an
# error" — that line means it fell back and you are not getting AI text.
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==================== PAYNOW PAYMENT GATEWAY ====================
# Paynow (https://www.paynow.co.zw) supports EcoCash, OneMoney and
# Visa/Mastercard from a single integration.
#
# Live mode: set PAYNOW_INTEGRATION_ID and PAYNOW_INTEGRATION_KEY with the
# values from your Paynow merchant account, and PAYMENT_MODE=live.
# Checkout redirects to Paynow, and the webhook at
# POST /api/billing/webhook verifies the transaction against Paynow before
# activating the subscription.
#
# Sandbox mode: leave the credentials empty (or PAYMENT_MODE=sandbox).
# The app simulates the gateway and fires the same webhook so the whole
# checkout -> webhook -> activation flow can be tested without real money.
PAYMENT_MODE=sandbox
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""

# Optional overrides
# PAYNOW_BASE_URL="https://www.paynow.co.zw/interface/remotetransaction"
# PAYMENT_CALLBACK_URL="http://localhost:3000/api/billing"

# ==================== SERVER / DEPLOYMENT ====================
# Most hosts (Render, Railway, Fly) set PORT automatically.
# PORT=3000

# Where runtime data is stored (users, sessions, workspaces, payments).
# In production, point this at a mounted persistent disk, e.g.:
# DATA_DIR=/opt/render/project/src/data
# DATA_DIR=/app/data

# ==================== SEARCH VISIBILITY (optional) ====================
# Enables "who is showing up above you" results in the Competitors tab.
# Create a Google Programmable Search Engine (https://programmablesearchengine.google.com)
# and a Custom Search JSON API key (https://developers.google.com/custom-search/v1/overview).
# Without these, competitor score comparison still works; rankings are simply
# reported as "not connected".
#
#
# ---------------------------------------------------------------------------
# RANK TRACKING (Google Search Console)
# ---------------------------------------------------------------------------
# Positions come from Google Search Console, which reports the average position
# Google actually ranked the site at, plus clicks and impressions.
#
# It uses the SAME service account as Google Analytics, so if you have already
# set that up there is nothing new to create. Enable the "Google Search Console
# API" on the project, then add the service-account address as a user on the
# Search Console property (Settings -> Users and permissions -> Add user).
#
# No extra variable is needed: GOOGLE_SERVICE_ACCOUNT_JSON above covers it.
#
# Honest limits worth knowing: position is an average over a window (not a live
# SERP rank), it only covers queries the site already appeared for, data lags
# 2-3 days, and it can never report a competitor's position.

# ---------------------------------------------------------------------------
# COMPETITOR SEARCH VISIBILITY ("who is showing up above you")
# ---------------------------------------------------------------------------
# This needs a whole-web search index. Google no longer provides one for new
# projects: the Custom Search JSON API is CLOSED TO NEW CUSTOMERS and is
# discontinued on 1 January 2027, and newly created Programmable Search Engines
# cannot search the entire web.
#
# So this runs on Brave Search, which has its own independent index. Results are
# labelled in the UI as coming from Brave and NOT from Google, because they are
# not the same rankings.
#
# Free tier: about 2,000 queries a month. Key from:
#   https://api-dashboard.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=""

# ---------------------------------------------------------------------------
# LEGACY: Google Custom Search (only works with a pre-existing whole-web engine)
# ---------------------------------------------------------------------------
# Do not set these up for a new project — see above. They are still honoured so
# anyone with a grandfathered engine keeps working until the 2027 sunset, and
# Brave takes priority if both are configured.
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""
# Optional, mainly for testing: point the search call at a local stub or a
# gateway instead of the real endpoint.
# BRAVE_SEARCH_BASE_URL="https://api.search.brave.com/res/v1/web/search"
# GSC_API_BASE_URL="https://searchconsole.googleapis.com/webmasters/v3"

# How long a login stays valid, in days. Defaults to 30.
# SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# DATABASE (required in production)
# ---------------------------------------------------------------------------
# Create a free database at https://turso.tech, then:
#   turso db show <db> --url       → TURSO_DATABASE_URL
#   turso db tokens create <db>    → TURSO_AUTH_TOKEN
#
# If these are unset the app uses a local file at <DATA_DIR>/searchvailable.db.
# That is ideal for development and tests — no account, no network — but on a
# host with no persistent disk (such as Render's free tier) the local file is
# wiped on every restart and deploy, so set these in production.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Optional: where the local fallback database lives. Defaults to <cwd>/data.
# DATA_DIR=""

# TRUST_PROXY: how many proxies sit in front of the app. This feeds req.ip,
# which the auth rate limiter is keyed on — so getting it wrong means every
# visitor shares one bucket and 30 failed logins lock out the whole app.
#   1  Render/Railway/Fly direct, or Cloudflare with the record set to "DNS only"
#   2  Cloudflare proxied (orange cloud) in front of Render
# Verify after deploying: curl https://your-domain/api/health and check
# resolvedClientIp shows YOUR address, not a Cloudflare one.
# TRUST_PROXY=1

# Auth endpoints are rate limited per IP (30 requests / 15 minutes) in-process.
# If you run more than one instance, move that to your host's edge limiter.


# ─────────────────────────────────────────────────────────────────────────────
# Email (account confirmation + password reset + monitoring alerts)
# ─────────────────────────────────────────────────────────────────────────────
# Uses the Resend HTTP API, so there is no SMTP setup and no extra dependency.
#   RESEND_API_KEY   from https://resend.com/api-keys
#   EMAIL_FROM       must be a domain you have verified with Resend
#
# Without a key the server does NOT pretend to send: it logs the message, and
# outside production it returns the link in the API response so you can still
# test the whole flow locally.
RESEND_API_KEY=""
EMAIL_FROM="Search Vailable <onboarding@resend.dev>"


# ─────────────────────────────────────────────────────────────────────────────
# Automated monitoring
# ─────────────────────────────────────────────────────────────────────────────
# Paid plans get scheduled re-checks: Growth every 7 days, Agency every day.
# Free plans are never checked automatically.
#
# MONITORING_ENABLED=false turns the scheduler off entirely.
# MONITOR_INTERVAL_MINUTES is how often the scheduler wakes up to look for
#   businesses that are due (default 15).
#
# NOTE: this is an in-process timer, so it only runs while the server is awake.
# On hosts that sleep idle instances, also add an external cron (Render Cron
# Job, GitHub Action, cron-job.org) that calls POST /api/monitor/run.
MONITORING_ENABLED="true"
MONITOR_INTERVAL_MINUTES="15"


# ─────────────────────────────────────────────────────────────────────────────
# Google Analytics 4 (measured visitor behaviour)
# ─────────────────────────────────────────────────────────────────────────────
# One credential for the whole server — users only ever type a numeric property
# ID, never a secret. The app then shows the service-account address and asks
# the client to add it as a VIEWER on their GA4 property.
#
# Easiest form (paste the whole downloaded JSON key on one line):
#   GA4_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":...,"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
#
# Or set the two fields separately (the \n escapes in the key are handled):
#   GA4_CLIENT_EMAIL="ga4-reader@your-project.iam.gserviceaccount.com"
#   GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# Without these, the analytics panel simply does not appear: the drop-off
# section stays in its honest "inferred" mode.
GA4_SERVICE_ACCOUNT_JSON=""
# GA4_CLIENT_EMAIL=""
# GA4_PRIVATE_KEY=""

# Optional: override the Google endpoints (proxy/gateway, or a local stub
# while testing). Defaults are the real Google URLs.
# GA4_OAUTH_URL="https://oauth2.googleapis.com/token"
# GA4_API_BASE_URL="https://analyticsdata.googleapis.com/v1beta"





